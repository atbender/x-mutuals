{
  "manifest_version": 3,
  "name": "Mutuals — a little more context",
  "version": "0.4.0",
  "description": "A quiet mutual-connections counter for X. Uses your current session. No account, API key, or tracking.",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Mutuals", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["endpoint.js", "core.js", "content.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
